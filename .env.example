# ============================================================
#  نوف — ملف الإعدادات. انسخه إلى .env وعبّئ القيم.
#  لا تضع هذا الملف (.env) في Git أبدًا.
#  لتوليد المفاتيح: python -m scripts.genkey
# ============================================================

# ---------- عام ----------
APP_ENV=production
APP_BASE_URL=https://noof.example.com
NOOF_DOMAIN=noof.example.com            # نطاقك (يُستخدم لشهادة HTTPS تلقائيًا)
SECRET_KEY=                             # إلزامي — من scripts.genkey
ENCRYPTION_KEY=                         # إلزامي — احفظ نسخة منه في مكان آمن؛ بدونه لا يمكن قراءة البيانات المشفرة
POSTGRES_PASSWORD=                      # كلمة مرور قوية لقاعدة البيانات
BACKUP_RETENTION_DAYS=14

# ---------- المالك ----------
OWNER_NAME=
OWNER_PHONE=9665XXXXXXXX                # رقمك الشخصي بالصيغة الدولية بدون + (منه تُرسل الأوامر لنوف)
OWNER_EMAIL=                            # اختياري: لنسخة من التقارير على البريد

# ---------- WhatsApp Cloud API (الرسمي من Meta) ----------
WA_API_VERSION=v23.0
WA_ACCESS_TOKEN=                        # System User Access Token دائم (Business Settings > System users)
WA_PHONE_NUMBER_ID=                     # Phone number ID لرقم نوف (المساعدة) من WhatsApp Manager
WA_BUSINESS_ACCOUNT_ID=                 # WABA ID
WA_APP_SECRET=                          # App Secret من إعدادات تطبيق Meta (للتحقق من التوقيع) — إلزامي
WA_VERIFY_TOKEN=                        # أي نص سري تختاره، وتضعه نفسه في إعداد Webhook لدى Meta
WA_OWNER_INBOX_PHONE_NUMBER_ID=         # اختياري لاحقًا: Phone number ID لرقمك الشخصي إن ربطته عبر Coexistence
WA_DRY_RUN=false                        # true = لا يرسل فعليًا (للتجربة)
WA_TEMPLATE_LANG=ar

# ---------- Claude (فهم الرسائل والأوامر والصور والمستندات) ----------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_ENABLED=true

# ---------- تحويل الرسائل الصوتية إلى نص ----------
STT_PROVIDER=azure                      # azure | openai | none
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=                    # مثال: uaenorth أو westeurope
STT_LANGUAGE=ar-SA
OPENAI_API_KEY=                         # فقط إن اخترت STT_PROVIDER=openai
OPENAI_STT_MODEL=whisper-1

# ---------- التقويم ----------
CALENDAR_PROVIDER=none                  # google | outlook | none
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=                   # نطاق https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_ID=primary
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=                       # صلاحية Application: Calendars.ReadWrite
MS_USER_ID=                             # بريد صاحب التقويم في Outlook/Microsoft 365

# ---------- CRM ----------
CRM_PROVIDER=internal                   # internal | webhook | hubspot
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
HUBSPOT_TOKEN=

# ---------- البريد (SMTP) ----------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
